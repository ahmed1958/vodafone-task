# Provider selection:
# auto = OpenRouter -> Gemini -> OpenAI -> Mock
# openrouter = use OpenRouter
# gemini = use Gemini
# openai = use OpenAI
# mock = deterministic local mode
AI_PROVIDER=openrouter

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free

# Optional Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Application settings
AI_TIMEOUT_SECONDS=20
MAX_PROMPT_LENGTH=5000
DATABASE_PATH=prompt_history.db
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false
